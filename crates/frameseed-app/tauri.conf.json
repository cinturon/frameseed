{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frameseed",
  "version": "0.1.0",
  "identifier": "com.frameseed.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Frameseed",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Procedural video generator",
    "longDescription": "FrameSeed renders short films and loops entirely from code — scenes, effects, and seeds — with live preview and MP4/GIF export.",
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
